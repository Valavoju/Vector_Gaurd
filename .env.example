# VectorGuard AI Environment Configuration
# All keys remain strictly server-side / build-time and are never exposed to the client.

# Weather API Configuration (Optional - Open-Meteo runs zero-key by default)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Map Tile Provider Key (Optional - standard tile layers active)
MAP_PROVIDER_KEY=

# Persistence / Database Connection (Optional)
DATABASE_URL=
