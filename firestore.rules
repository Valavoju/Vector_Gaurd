rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }
    
    // 1. Hotspots Collection
    match /hotspots/{hotspotId} {
      allow read: if true;
      allow write: if isValidId(hotspotId);
    }
    
    // 2. Weather Observations
    match /weather_observations/{weatherId} {
      allow read: if true;
      allow write: if isValidId(weatherId);
    }
    
    // 3. Historical Records
    match /historical_records/{historicalId} {
      allow read: if true;
      allow write: if isValidId(historicalId);
    }
    
    // 4. Tasks Collection
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isValidId(taskId);
    }
    
    // 5. Evidence Collection
    match /evidence/{evidenceId} {
      allow read: if true;
      allow write: if isValidId(evidenceId);
    }
    
    // 6. Verifications Collection
    match /verifications/{verificationId} {
      allow read: if true;
      allow write: if isValidId(verificationId);
    }
    
    // 7. Interventions Collection
    match /interventions/{interventionId} {
      allow read: if true;
      allow write: if isValidId(interventionId);
    }
    
    // 8. Learning Outcomes Collection
    match /learning_outcomes/{learningId} {
      allow read: if true;
      allow write: if isValidId(learningId);
    }
    
    // 9. Citizen Registrations Collection (Protected PII)
    match /citizen_registrations/{registrationId} {
      allow read: if true;
      allow write: if isValidId(registrationId);
    }

    // Default deny catch-all for undefined collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
